{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindowsWallPaper",
  "mainBinaryName": "windows-wallpaper",
  "version": "1.14.0",
  "identifier": "com.windowswallpaper.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "WindowsWallPaper",
        "width": 1400,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "transparent": false,
        "decorations": true,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
